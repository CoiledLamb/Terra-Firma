<?xml version="1.0" encoding="utf-8"?>
<objects>
  <!-- RE-PARENTED 2026-08-26 (inverted-hierarchy ruling 2026-08-11: "just because it was made
       first doesn't mean it needs to be first"; wild form user-verified same day, passing the
       ruled build-order gate). The wild base owns the animal: anatomy, brackish basin + salt
       producer, bleed tags, species, gender, glaze tint, farm-prey brain. This layer is pet
       privilege only. Child parts MERGE attribute-by-attribute over the parent's (base idiom,
       e.g. corpse Render overrides), so lines here state only what differs. -->
  <object Name="Cleo_TerraFirma_BoarVessel" Inherits="Cleo_TerraFirma_BaseBoarVessel">
    <!-- Passive = the engine's defensive-pet engagement flag (Brain.CanAcquireTarget returns
         false; look text reads "Engagement style: defensive"). Added 2026-07-24 (user live-fire
         flag: the vessel was picking fights; "it should be passive like ercolano"). Note the
         merge now also carries the parent's Swine/Prey factions; player-led standing outranks
         faction feeling, watch on the one-boot check. -->
    <part Name="Brain" Passive="true" />
    <!-- Husangeion (user ruling 2026-08-07): hus (pig) + aggeion (vessel), gamma-gamma as "ng".
         Replaced Hûskévos; accented chars CANNOT render: the classic font indexes its glyph
         atlas by raw Unicode codepoint (û/251 drew as the √ glyph, é/233 as Θ), and the CP437
         slots those glyphs occupy are untypeable C1 controls. Display names must stay ASCII. -->
    <part Name="Render" DisplayName="Husangeion" />
    <part Name="Description" Short="A roughly shaped piece of earth meant to resemble the common sow, mud still wet after decades of drying. Though the hands of whoever first worked this are unknown, their living record remains in this constant companion."></part>
    <!-- Pure water is pet privilege (ruled; "fresh water stays a pet privilege"): these two
         part-name merges override the parent's brackish start mix and salt producer. -->
    <part Name="LiquidVolume" MaxVolume="64" Volume="64" StartVolume="1d33-1" InitialLiquid="water-1000" ManualSeal="true" />
    <part Name="LiquidProducer" Liquid="water" VariableRate="200-2000" WorksOnWearer="false" WorksOnSelf="true" />
    <!-- NO GUT CISTERN off the pet (USER RULED 2026-08-26: "the pet gut cistern i'm less keen
         on"; cistern moved to corpse butchery 2026-08-27): the parent now carries a butcherable
         corpse, so the pet suppresses it, preserving its prior corpse-less death. Keeps the
         Husangeion from becoming its own loot table. -->
    <part Name="Corpse" CorpseChance="0" />
    <!-- Pet-privilege statline (wild base runs boar-anchored DRAFT dice) -->
    <stat Name="Level" Value="1"></stat>
    <stat Name="AV" Value="5"></stat>
    <stat Name="Hitpoints" Value="100"></stat>
    <tag Name="PetResponse" Value="sloshes excitedly,whines and clinks,rolls over - it might not be able to get up..." />
    <part Name="Pettable" />
    <tag Name="Pet"/>
    <tag Name="StartingPet"/>
    <xtagGrammar Proper="true"></xtagGrammar>
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
    <tag Name="NoCombat"></tag>
  </object>
</objects>