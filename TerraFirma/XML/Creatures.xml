  <!-- Rockhound (user sprite 2026-08-12; build green-lit 2026-08-13: "we can start building
       creatures so they're ready with the stonecarver pass"). Wild-stray form; the kept camp
       variant is one faction entry later (Dogs-100 + carver faction at 99, Herding Dog idiom,
       waits on the post-NPCs faction debt; probably wants base's Grazer tag then too).
       Chassis: BaseDog (Pettable and Dogs-100 arrive free). Gut: Cleo_TerraFirma_RockSweeper,
       swallow-and-spill (see the part for provenance). STATS ARE DRAFT, numbers sitting owed.
       Named "gneisshund" 2026-10-19 (user); ID and tile keep rockhound. Render colors PLACEHOLDER,
       user's sprite palette to rule. ExcludeFromDynamicEncounters dropped 2026-10-19 (user),
       so it rolls in the dynamic BaseDog pool; no table rows yet. -->
  <object Name="Cleo_TerraFirma_Rockhound" Inherits="BaseDog">
    <part Name="Render" DisplayName="gneisshund" Tile="rockhound.png" RenderString="d" ColorString="&amp;w" DetailColor="y" />
    <part Name="Corpse" CorpseChance="100" CorpseBlueprint="Dog Corpse" />
    <stat Name="Level" Value="8" />
    <stat Name="Hitpoints" Value="18" />
    <stat Name="AV" Value="2" />
    <part Name="Cleo_TerraFirma_RockSweeper" />
    <!-- NO ConversationScript, RULED 2026-08-16 alongside the cobble baboon (user: "if basedog is
         mute, then we are good on rockhounds also"). BaseDog carries none, so the rockhound is
         mute by inheritance and by intent. Contrast the Husangeion, which opted out the other
         way: it takes PetResponse lines rather than a conversation. -->
    <inventoryobject Blueprint="BigDog_Bite" Number="1" />
    <part Name="Description" Short="Nose to the ground, =pronouns.subjective= =verb:hunt:afterpronoun= for bits of spall amongst the desert scrub. As =pronouns.subjective= =verb:trot:afterpronoun=, the stones in =pronouns.possessive= stomach click and settle against each other." />
    <tag Name="Role" Value="Brute" />
  </object>

  <object Name="Cleo_TerraFirma_Snapjaw Miner" Inherits="Snapjaw">
    <part Name="Render" DisplayName="snapjaw miner" Tile="snapjaw miner.png" ColorString="&amp;w" DetailColor="y" />
    <stat Name="Hitpoints" Value="6" />
    <inventoryobject Blueprint="Pickaxe" Number="1" />
    <!-- overrides the ConversationID inherited from base Snapjaw (2026-08-16); bank in Conversations.xml -->
    <part Name="ConversationScript" ConversationID="Cleo_TerraFirma_SnapjawMiner" />
    <tag Name="Role" Value="Minion" />
  </object>
  <!-- BOAR VESSEL, wild base (NAME RULED 2026-08-26, user: "boar over pig"; full design record
       in TODO.md creature roster). INVERTED HIERARCHY ruling 2026-08-11: this base owns the
       animal; the Husangeion pet (XML/Pets.xml) re-parents onto it only AFTER this blueprint
       verifies in game. Basin = the creature's own unsealed tank, trending brackish via the salt
       producer (LiquidProducer.IsNeeded self-stops at full, decomp-verified); glaze lies per the
       2026-08-11 ruling, VesselTint stays majority-liquid. Cistern = real worn equipment on the
       plain Body slot, unremovable via NaturalEquipment (USER RULED 2026-08-26, superseding the
       custom bodyparttype + anatomy, both deleted); drops sealed on death. Flee shape: stock
       farm-prey idiom only (base has no flee flag; recon 2026-08-26), watch it in game before
       adding anything. ALL STATS AND RATES DRAFT, numbers sitting owed. Description approved
       2026-09-08. ExcludeFromDynamicEncounters per
       the creatures-branch charter; spawn wiring is its own future ruling. -->
  <object Name="Cleo_TerraFirma_BaseBoarVessel" Inherits="BaseAnimal">
    <part Name="Brain" Hostile="false" Factions="Swine-100,Prey-100" /> <!-- base Boar idiom + Prey-100 per user soft pick 2026-08-11 -->
    <part Name="Body" Anatomy="Cleo_TerraFirma_BoarVessel" /> <!-- the pet's own anatomy, shared; see XML/Bodies.xml -->
    <part Name="Render" DisplayName="boar vessel" Tile="boar vessel.png" RenderString="b" ColorString="&amp;w" DetailColor="B" />
    <part Name="Description" Short="A depiction of the common sow, painted with the rough brush of clay, roots aimlessly in the dirt. Water sloshes gently in =pronouns.possessive= basin as =pronouns.subjective= =verb:amble:afterpronoun= along." /> <!-- Description approved 2026-09-08. -->
    <part Name="LiquidVolume" MaxVolume="64" Volume="64" StartVolume="1d33-1" InitialLiquid="water-800,salt-200" ManualSeal="true" /> <!-- basin; pet tank shape, brackish start mix DRAFT -->
    <part Name="Cleo_TerraFirma_VesselTint" EmptyColor="k" />
    <part Name="LiquidProducer" Liquid="salt" FillSelfOnly="true" VariableRate="500-5000" WorksOnWearer="false" WorksOnSelf="true" /> <!-- salty fill over time; RATE DRAFT. Pet overrides this by part-name replacement at re-parent -->
    <stat Name="Level" Value="1" />
    <stat Name="AV" Value="3" /> <!-- DRAFT; base Boar AV 4 anchor, walks like a boar and breaks like a pot -->
    <stat Name="Hitpoints" Value="15" /> <!-- DRAFT; base Boar 13 -->
    <tag Name="Species" Value="oddity" />
    <tag Name="Gender" Value="neuterperson" />
    <xtagTextFragments Skin="glaze" PoeticFeatures="artfulness,gentle stillness,childlike wonder" />
    <tag Name="BleedLiquid" Value="water-900,salt-100" />
    <tag Name="BleedColor" Value="&amp;B" />
    <tag Name="BleedPrefix" Value="{{B|wet}}" />
    <!-- Split 2026-09-27: Terra Firma keeps this body for Husangeion only. The wild spawn
         tables and the butcherable corpse are Terra Firma 2 content, merged back onto this
         blueprint by TerraFirma2/XML/Creatures.xml, which also removes this exclude tag. -->
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>
</objects>
