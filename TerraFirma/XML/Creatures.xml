  <!-- Rockhound (user sprite 2026-08-12; build green-lit 2026-08-13: "we can start building
       creatures so they're ready with the stonecarver pass"). Wild-stray form; the kept camp
       variant is one faction entry later (Dogs-100 + carver faction at 99, Herding Dog idiom,
       waits on the post-NPCs faction debt; probably wants base's Grazer tag then too).
       Chassis: BaseDog (Pettable and Dogs-100 arrive free). Gut: Cleo_TerraFirma_RockSweeper,
       swallow-and-spill (see the part for provenance). STATS ARE DRAFT, numbers sitting owed.
       Name lock owed ("rockhound" working; candidate list in TODO). Render colors PLACEHOLDER,
       user's sprite palette to rule. ExcludeFromDynamicEncounters = controlled debut; remove
       or replace with real table tags at the spawn-wiring pass. -->
  <object Name="Cleo_TerraFirma_Rockhound" Inherits="BaseDog">
    <part Name="Render" DisplayName="rockhound" Tile="rockhound.png" RenderString="d" ColorString="&amp;w" DetailColor="y" />
    <part Name="Corpse" CorpseChance="100" CorpseBlueprint="Dog Corpse" />
    <stat Name="Level" Value="8" />
    <stat Name="Hitpoints" Value="18" />
    <stat Name="AV" Value="2" />
    <part Name="Cleo_TerraFirma_RockSweeper" />
    <inventoryobject Blueprint="BigDog_Bite" Number="1" />
    <part Name="Description" Short="Dust grays =pronouns.possessive= coat and =pronouns.possessive= muzzle is worn smooth as riverstone. When =pronouns.subjective= =verb:trot:afterpronoun=, something in =pronouns.possessive= belly clicks and settles, stone against swallowed stone." /> <!-- DRAFT, signoff owed -->
    <tag Name="Role" Value="Brute" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>

  <!-- Snapjaw miner (user sprite 2026-08-12; build green-lit 2026-08-13). Behavior PARENT in
       the base two-layer idiom (Snapjaw Scavenger precedent): tier children, if ruled in at
       wiring, are pure InventoryPopulationTable swaps on top of this. The pickaxe IS the AI
       (recon 2026-08-13, banked in TODO): DiggingTool installs Digging on the wielder, Drill
       answers PathAsBurrowerEvent, so he tunnels while traveling and fights through walls to
       reach a target with zero C#. Placement leans banked (any snapjaw group + sometimes
       canyon-wild); ExcludeFromDynamicEncounters = controlled debut (Snapjaw parent tags would
       otherwise seed him into canyon, saltmarsh, and hills pools TODAY, ahead of the wiring
       pass and the party-table merge). HP is DRAFT (Hunter-grade 6 over base 3, he swings a
       real tool); Role DRAFT Minion; render colors PLACEHOLDER. Description identity kept
       NEUTRAL on purpose: what a miner snapjaw wants is still the user's open call. -->
  <!-- Cobble baboon (settled 2026-08-13 sitting; user structure ruling: creature plain,
       "-fur" reserved for the pelt items, quartz/quartzfur grammar. NAME LOCKED cobble
       same day, superseding Claude's gravel pick: "gravel baboon" + the Gravel Whorl effect
       title colliding in every combat sentence of his signature moment was the user's
       (correct) log-legibility fear; gravel = considered-and-passed alternate. Chassis:
       Baboon child, so the StoneScavenger merge, pocket Small Stones, AIThrowAndScoot,
       Skirmisher role, and the Hills/DesertCanyon table tags all arrive by inheritance
       (canyon habitat RULED 2026-08-15, user: "it's fine for the cobble
       baboon to be in desert canyons" and it costs nothing, the parent tags deliver it.
       Provenance note: this comment previously recorded the lean as "confirmed by silence on
       the alternative," which was consent read off an absence; now it is an actual ruling).
       Signature: Earthen Barrage — NPC auto-arm shipped 2026-08-06 (mutation re-sculpts
       every EndTurn, base AI throws the slot natively), so the whole creature is this one
       XML block. Differentiation from base Quartz Baboon on file: quartz = stone SKIN
       (armor/reflect, L22 subterrane); gravel = stone THROWN (barrage/whorl, early canyon).
       STATS + EB LEVEL DRAFT (Hulking-grade body, EB 4 for a visible whorl), numbers
       sitting owed. Tile = recolored base baboon PLACEHOLDER, sprite debt filed.
       Corpse: custom, CorpseChance 15 DRAFT (down from the inherited 40; he will be a
       common canyon spawn and 40% would carpet the canyon in pelts; quartz ships at 6).
       Butchery = the cobblefur family (bracer/gloves/cloak, quartzfur three-piece idiom),
       table in PopulationTables.xml. ExcludeFromDynamicEncounters = controlled debut,
       lift at the spawn-wiring pass. -->
  <object Name="Cleo_TerraFirma_Cobble Baboon" Inherits="Baboon">
    <part Name="Render" DisplayName="cobble baboon" Tile="Assets_Content_Textures_Creatures_sw_baboon.bmp" ColorString="&amp;y" DetailColor="K" />
    <stat Name="Hitpoints" Value="15" />
    <stat Name="Strength" Boost="2" />
    <stat Name="AV" Value="3" />
    <!-- mutation nodes resolve by CLASS name, not display name (caught 2026-08-14: the display
         name loaded as a MODERROR + unnamed-node warn and the baboon spawned barrage-less) -->
    <mutation Name="Cleo_TerraFirma_EarthenBarrage" Level="4" />
    <part Name="Corpse" CorpseChance="15" CorpseBlueprint="Cleo_TerraFirma_Cobble Baboon Corpse" />
    <part Name="Description" Short="Grit clings to =pronouns.possessive= coat in dun sheets, and around =pronouns.objective= the air is never quite still: pebbles circle =pronouns.possessive= shoulders in a lazy orbit, waiting to be thrown." /> <!-- DRAFT, signoff owed -->
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>
  <object Name="Cleo_TerraFirma_Cobble Baboon Corpse" Inherits="Baboon Corpse">
    <part Name="Render" DisplayName="cobble baboon corpse" />
    <part Name="Butcherable" OnSuccess="@Cleo_TerraFirma_Cobblefur Items" />
    <tag Name="Tier" Value="2" />
  </object>

  <object Name="Cleo_TerraFirma_Snapjaw Miner" Inherits="Snapjaw">
    <part Name="Render" DisplayName="snapjaw miner" Tile="snapjaw miner.png" ColorString="&amp;w" DetailColor="y" />
    <stat Name="Hitpoints" Value="6" />
    <inventoryobject Blueprint="Pickaxe" Number="1" />
    <part Name="Description" Short="Quarry dust grays =pronouns.possessive= tussocked fur, and =pronouns.possessive= knuckles are chipped white from wall-work. =pronouns.Subjective= =verb:eye:afterpronoun= every rockface like a shut door." /> <!-- DRAFT, signoff owed -->
    <tag Name="Role" Value="Minion" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>

  <!-- BASE STONECARVER BODY (2026-08-15, opened for the legendary roller wish). This is a
       CHASSIS, not a roster entry: no profession, no role tag, no gear. Profession-first
       structure is RULED (user 2026-08-15, "it's a qud idiom") but the professions themselves,
       their DetailColors past the ruled overseer pink / outrider blue / mason grey, and the
       BASELINE KIT under the epithet grant are all still owed. Deliberately bare so the
       legendary builder's output is the only thing you see.
       Human half of the compressed two-body shape; stonerat.png (mole half) has no blueprint
       yet either. Faction is inherited Humanoids-100 because the carver faction entry is
       scheduled AFTER the NPC build by ruling. ExcludeFromDynamicEncounters: wish-door only. -->
  <object Name="Cleo_TerraFirma_Stonecarver" Inherits="BaseHumanoid">
    <!-- COLORS ACCEPTED BY THE USER 2026-08-15 ("these are fine for base colors"): grey body,
         dark grey detail. An interim brown/white pass lived and died the same sitting; it was
         Claude misreading a report about the LEGENDARIES as a complaint about the base.
         CHANNEL MAPPING CORRECTED 2026-08-15 by the user's eyes (they saw the role colors
         "recoloring the wrong bits" and called the flip). Claude had inferred from a pixel count
         (66 black to 28 white) that DetailColor paints the black majority. Observation says
         otherwise, so the pair is swapped: the ROLE color now rides ColorString and the shared
         grey sits in DetailColor. The pixel count was real; the channel it maps to was a guess,
         and a guess is not a measurement. -->
    <part Name="Render" DisplayName="stonecarver" Tile="stonecarver.png" ColorString="&amp;K" DetailColor="y" />
    <!-- Faction landed 2026-08-15. Replaces the inherited Humanoids-100 from BaseHumanoid, and
         every role inherits it from here. Neutral to the player at 0 starting rep by the faction
         entry, so a pack is not automatically hostile; whether quarriers should OPEN friendly,
         wary or hostile is a real design call and is deliberately not made here. -->
    <part Name="Brain" Factions="Cleo_TerraFirma_Quarriers-100" />
    <part Name="Description" Short="Chalk dust has worked so far into the creases of =pronouns.possessive= hands that the lines read like a map of somewhere quarried." /> <!-- DRAFT, and deliberately identity-neutral: the professions carry who these people are, and they are not built yet -->
    <stat Name="Level" Value="10" /> <!-- CLAUDE PLACEHOLDER, numbers sitting owed -->
    <!-- NOTE the missing "*noinherit" here, unlike every other creature in this file: that marker
         stops a tag reaching children, and the whole point on this blueprint is that every role
         built on top INHERITS the spawn gate. Caught while adding the roster: with the marker in
         place the roles would have shipped ungated, ahead of any spawn wiring ruling. -->
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- THE ROSTER, built 2026-08-15. Roles were RULED 2026-07-22 (hewer / mason / outrider /
       drover / provisioner / overseer); this pass builds three of them, per the user's rulings
       the same day: PROVISIONER CUT (its trade role moved to the vine merchant 08-11 and packs
       no longer trade, so nothing was left for it to do), DROVER OUT OF THIS PASS (still bounded
       by the open beast design), and OVERSEER needs no blueprint at all because it was ruled as
       "same blueprint, legendary" back at the color map: any carver the hero builder touches
       becomes one, and the pink comes with it.
       Profession-first structure is RULED 2026-08-15 ("it's a qud idiom"): the profession is the
       face (name, description, camp presence), the mutation is the engine it works with, and the
       Role tag is NOT the AI layer (see the Role recon in TODO; it is difficulty, spawn weight,
       XP and a Minion stat penalty). COLOR CARRIER FLIPPED 2026-08-15 at the user's call: the
       role rides ColorString, the shared grey sits in DetailColor. Legendaries are deliberately
       NOT flipped, their pink stays where the hero convention puts it.
       Mason grey RULED 2026-08-15 with its consequence accepted: it overlaps the grey-creature-
       means-statue register the stonefrog uses. The user took the product rhyme (a mason makes
       statues, statues are grey) over the exclusivity.
       DRAFT and owed: every mutation LEVEL (numbers sitting), every Role tag, all descriptions,
       and the mole variants' display names. NO GEAR: kits are the next pass by the user's own
       sequencing, so a role currently carries its mutation and nothing else. -->

  <object Name="Cleo_TerraFirma_Hewer" Inherits="Cleo_TerraFirma_Stonecarver">
    <part Name="Render" DisplayName="hewer" ColorString="&amp;r" />
    <part Name="Description" Short="=pronouns.Subjective= =verb:read:afterpronoun= the rock face the way a reader finds a paragraph break, and =pronouns.subjective= =verb:open:afterpronoun= it there." /> <!-- DRAFT, signoff owed -->
    <mutation Name="Cleo_TerraFirma_Fissure" Level="4" /> <!-- level DRAFT -->
    <tag Name="Role" Value="Brute" /> <!-- DRAFT -->
  </object>

  <object Name="Cleo_TerraFirma_Mason" Inherits="Cleo_TerraFirma_Stonecarver">
    <part Name="Render" DisplayName="mason" ColorString="&amp;y" />
    <part Name="Description" Short="Stone dust has settled into =pronouns.possessive= sleeves so thoroughly that =pronouns.subjective= =verb:carry:afterpronoun= the quarry around with =pronouns.objective=." /> <!-- DRAFT, signoff owed -->
    <mutation Name="Cleo_TerraFirma_Stoneshaper" Level="4" /> <!-- level DRAFT -->
    <!-- Role RECON 2026-08-15 (user: "we should investigate creature AI roles more thoroughly").
         Role is NOT an AI layer, whatever the tracker said: nothing under XRL.World.Parts or
         XRL.World.AI reads it. It feeds difficulty rating, dynamic spawn weight, XP value, and a
         stat penalty. The first draft here said Minion, which was actively wrong: Minion docks a
         boost step off ALL SIX attributes, reads 5 levels weaker than it is, quarters its own
         level in a threat check, and pays 20x XP instead of 50x. A mason is a peer profession,
         not a mook. Summoner is the honest tag AND the literal truth (Stoneshaper summons statue
         companions); it rates +4 difficulty, so the con warning matches what the fight becomes. -->
    <tag Name="Role" Value="Summoner" />
  </object>

  <object Name="Cleo_TerraFirma_Outrider" Inherits="Cleo_TerraFirma_Stonecarver">
    <part Name="Render" DisplayName="outrider" ColorString="&amp;B" />
    <part Name="Description" Short="=pronouns.Subjective= =verb:walk:afterpronoun= the edge of the claim with stones already circling =pronouns.possessive= shoulders, waiting." /> <!-- DRAFT, signoff owed -->
    <mutation Name="Cleo_TerraFirma_EarthenBarrage" Level="4" /> <!-- level DRAFT -->
    <tag Name="Role" Value="Artillery" /> <!-- DRAFT -->
  </object>

  <!-- MOLE HALF of the two-body shape. The mole-folk species axis had sat as an unratified user
       float since 2026-08-07; RATIFIED BY BUILDING 2026-08-15 at the user's direction (they chose
       both bodies for this pass). Each variant is a thin child of its own role, so the profession
       stays the identity and only the body changes: stonerat.png plus Burrowing Claws.
       PathAsBurrower is OFF, a CLAUDE PICK: with it on they path THROUGH walls, and a warren is
       a hand painted thing they would tunnel straight out of. The claws still dig and still hit.
       Species tag left inherited on purpose. Building the body does not require claiming the
       species string, and what these people ARE is the user's lore call, not a side effect.
       Display names are Claude DRAFT: they exist only so the two bodies are tellable apart in a
       log. If the profession alone should name both, say so and they collapse. -->

  <object Name="Cleo_TerraFirma_Mole Hewer" Inherits="Cleo_TerraFirma_Hewer">
    <part Name="Render" DisplayName="mole hewer" Tile="stonerat.png" /> <!-- name DRAFT -->
    <mutation Name="BurrowingClaws" Level="4" PathAsBurrower="false" />
  </object>

  <object Name="Cleo_TerraFirma_Mole Mason" Inherits="Cleo_TerraFirma_Mason">
    <part Name="Render" DisplayName="mole mason" Tile="stonerat.png" /> <!-- name DRAFT -->
    <mutation Name="BurrowingClaws" Level="4" PathAsBurrower="false" />
  </object>

  <object Name="Cleo_TerraFirma_Mole Outrider" Inherits="Cleo_TerraFirma_Outrider">
    <part Name="Render" DisplayName="mole outrider" Tile="stonerat.png" /> <!-- name DRAFT -->
    <mutation Name="BurrowingClaws" Level="4" PathAsBurrower="false" />
  </object>
</objects>