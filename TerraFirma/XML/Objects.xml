<?xml version="1.0" encoding="utf-8" ?>
<objects>
	<object Name="Cleo_TerraFirma_EphemeralStone" Inherits="BaseStone">
		<part Name="Render" DisplayName="sculpted pebble" Tile="Items/sw_smallstone.bmp" />
		<part Name="Physics" Weight="1" Category="Thrown Weapons" />
		<part Name="Description" Short="A piece of rock was water-cleaved from its birthing bed and tumbled by time into a sphere." />
		<part Name="Temporary" Duration="30" /> <!-- Silent property removed from the Temporary part in a game update -->

		<part Name="ThrownWeapon" Penetration="4" Damage="1d8" Attributes="Cudgel" /> <!-- these are just placeholder; actual damage is set in C# -->
		<part Name="Cleo_TerraFirma_StoneRearmOnTakePart" /> <!-- pickup re-arm (2026-08-12): a stone taken off the ground goes straight back into an empty thrown slot; resonant child inherits -->
		<stag Name="Thrown" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>
	<object Name="Cleo_TerraFirma_EphemeralStoneResonant" Inherits="Cleo_TerraFirma_EphemeralStone">
		<part Name="Render" DisplayName="{{C|resonant}} sculpted pebble" ColorString="&amp;C" TileColor="&amp;C" DetailColor="c" />
		<part Name="Description" Short="A piece of rock was water-cleaved from its birthing bed, tumbled by time into a sphere, and hollowed by will until it hums at the frequency of whatever it meets." />
		<part Name="VibroWeapon" ChargeUse="0" />
		<part Name="ThrownWeapon" Penetration="4" Damage="1d8" Attributes="Cudgel Vorpal" /> <!-- Vorpal = thrown-path vibro; damage still set in C# -->
	</object>
	<object Name="Cleo_TerraFirma_WallCalcify" Inherits="Sandstone">
		<!-- fallback wall for Calcify when the zone defines no default wall and no stone neighbor
		     is found. RULED 2026-08-04 ("let's have the fallback stone wall be the same for both
		     calcify and fissure"): dressed identically to Fissure's no-geology fallback, neutral
		     gray &y^K (limestone scheme) over the inherited wall_rock paint family, never raw
		     sandstone red. DisplayName = DRAFT under the beta-text ruling (a gray wall reading
		     "sandstone" would be worse); release sitting signs off. -->
		<!-- DisplayName is the bare noun ON PURPOSE (bug 2026-08-05: "calcified calcified stone"):
		     every spawn of this blueprint comes through Calcify's PlaceWall, which attaches
		     Cleo_TerraFirma_CalcifyWallPart, and THAT part prepends "calcified" via GetDisplayName.
		     Borrowed walls render "calcified shale"; this one renders "calcified stone". -->
		<part Name="Render" DisplayName="stone" ColorString="&amp;y^K" TileColor="&amp;y" DetailColor="K" />
		<!-- rebalance 2026-08-06 (true-copy walls): the wall part no longer overrides descriptions,
		     so the fallback carries its own here (the former part text, verbatim); without it a
		     gray "calcified stone" would read Sandstone's inherited description. Borrowed walls
		     need nothing: they ARE their source blueprint now, description and stats included.
		     Stats ride the Sandstone inherit (150 HP, AV 8); the no-geology floor. -->
		<part Name="Description" Short="Dust and grit were strung into cubic costume and set to bar passage." />
		<!-- seam fix (2026-08-05, with Rocks.xml's fallen wall): distinct blueprint = the painter
		     draws broken faces against fissure walls and zone stone. Same two hooks as there:
		     PaintPart fuses this wall toward any mod-marked stone; PaintWith "*" fuses neighbors
		     toward it. -->
		<tag Name="PaintWith" Value="*" />
		<tag Name="PaintPart" Value="Cleo_TerraFirma_StoneshaperWallProperties" />
	</object>
	<object Name="Cleo_TerraFirma_StoneshaperStatue" Inherits="Random Statue">
		<tag Name="Animatable" />
		<tag Name="NoTrade" />
		<!-- no NoFollowerDeathPopup here (RULED 2026-08-07): combat deaths and natural expiry
		     both get the engine's mourning popup (DeanimateStatue's CustomDeathVerb makes expiry
		     read "expired", not "died"). The swap-carve branch alone stays quiet via a property
		     stamp in Mutation_Stoneshaper; the player just ordered that de-animation. -->
		<tag Name="NoAnimatedNamePrefix" />
		<tag Name="DeathSounds" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_die" />
		<tag Name="TakeDamageSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_hurt" />
		<tag Name="AmbientIdleSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_idle" />
		<tag Name="PunchSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_attack" />
		<part Name="RandomStatue" StatueType="sculpture" />
	</object>
	<object Name="Cleo_TerraFirma_StoneshaperStatueNaturalWeapon" Inherits="NaturalWeapon">
		<part Name="Render" DisplayName="{{y|gravelly haymaker}}" Tile="Creatures/natural-weapon-fist.bmp" ColorString="&amp;K" />
		<!-- VibroWeapon CUT at the statue identity audit (RULED 2026-08-09): armor-matching
		     penetration erased both enemy AV and the muse's inherited Strength. The fist now
		     penetrates off Strength alone, uncapped per the natural-weapon idiom (vanilla
		     NaturalWeapon base is MaxStrengthBonus 1000, user-verified direction) - pick a
		     strong muse, hit harder. -->
		<part Name="MeleeWeapon" MaxStrengthBonus="1000" BaseDamage="1d3+1" Skill="Cudgel" Stat="Strength" />
	</object>
	<object Name="Cleo_TerraFirma_StatueMaker" Inherits="Tool">
		<part Name="Render" DisplayName="claysculpting loop" RenderString="004" ColorString="&amp;C" TileColor="&amp;b" DetailColor="C" Tile="Items/portable-wall.png" />
		<part Name="Commerce" Value="25" />
		<part Name="Description" Short="placeholder description >:)" />
		<part Name="Physics" Weight="8" Category="Tools" />
		<part Name="Cleo_TerraFirma_StatueMakerPart" />
		<part Name="Examiner" Unknown="UnknownOddTrinket" Complexity="3" />
		<tag Name="Tier" Value="3" />
		<!-- BETA-HELD (RULED 2026-08-05: "we should just bench the statue making item with the rest
		     of the gear we're adding in phase 2"): all three acquisition surfaces gated below; the
		     blueprint + part stay compiled as an inert dev door (wish-reachable only), per the
		     redoubt pivot's spawn-layer gating philosophy. The placeholder description rides the
		     bench; its real text moves to the phase-2 gearset pass. Restore = uncomment.
		<tag Name="Gift" Value="*noinherit" />
		<tag Name="GiftSkillRestriction" Value="Tinkering_Scavenger" />
		<part Name="TinkerItem" Bits="0013" CanDisassemble="true" CanBuild="true" />
		<tag Name="DynamicObjectsTable:Trinkets" />
		-->
	</object>
	<!-- Glowstone pair (2026-08-22): descriptions are USER TEXT FINAL, mechanics per the same
	     sitting's rulings - shards ride base MoteProperties verbatim (user: "let's just use
	     moteproperties on this one"; Fuel 5000 is a Claude dial ~4.2 in-game days, mote parity);
	     the lantern socket, steady radius, and half-rate burn live in Part_GlowstoneLantern.cs.
	     Acquisition = breaking a glowsphere (Merges.xml) or wish only; spawn layer unruled.
	     Known wart, flagged: MoteProperties' burnout verb is hardcoded "dissipates". -->
	<object Name="Cleo_TerraFirma_GlowstoneShard" Inherits="LightSource">
		<part Name="Render" DisplayName="{{Y|glowsphere}} fragment" RenderString="'" ColorString="&amp;Y" DetailColor="y" Tile="glowsphere_shard.png" RenderLayer="5" />
		<part Name="LightSource" Lit="false" Radius="6" />
		<part Name="MoteProperties" Fuel="5000" />
		<part Name="Physics" Weight="1" />
		<part Name="Commerce" Value="5" />
		<part Name="Description" Short="a perfect pearl of light was shattered, yet no life springs forth from it. its glow wanes in the harvest dawn, memories of wholeness reflected in the high salt sun." />
		<!-- NO Stacker on purpose (2026-08-22): a stack is ONE object, so stacked shards would
		     share a single Fuel pool and die together - the 2-3-per-sphere ruling only means
		     anything if each shard burns alone. (Base Luminous Mote carries this wart; its motes
		     just rarely arrive in multiples.) -->
		<part Name="ItemElements" Elements="stars::1" />
		<!-- combat rider (user ruling 2026-08-22): phosphorescent (= base Luminous, verbatim) on
		     any hit; thrown-only bleed chance behind a pens>0 gate. ThrownWeapon = Small Stone
		     parity (1d2). Dials in the part are CLAUDE numbers. -->
		<part Name="ThrownWeapon" Damage="1d2" />
		<part Name="Cleo_TerraFirma_GlowstoneShardOnHit" />
		<stag Name="Thrown" />
		<part Name="AnimatedMaterialGeneric" AnimationLength="200" ColorStringAnimationFrames="0=&amp;Y,100=&amp;y" DetailColorAnimationFrames="0=y,100=Y" />
		<tag Name="Tier" Value="2" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>
	<object Name="Cleo_TerraFirma_GlowstoneLantern" Inherits="LightSource">
		<part Name="Render" DisplayName="lantern" RenderString="}" ColorString="&amp;K" TileColor="&amp;K" DetailColor="Y" Tile="lantern_unlit.png" RenderLayer="5" />
		<part Name="LightSource" Lit="false" Radius="8" />
		<part Name="Cleo_TerraFirma_GlowstoneLantern" />
		<part Name="Physics" Weight="2" />
		<part Name="Commerce" Value="25" />
		<!-- description is state-swapped by the part: lit = the locked user line, unlit = a
		     PLACEHOLDER awaiting the user's own text -->
		<part Name="Description" Short="a wrought metal cage sits empty." />
		<tag Name="Tier" Value="3" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>
	<!-- Grinder cell (2026-08-22): description USER TEXT FINAL; shape + numbers user-approved
	     same sitting (weight x 20 charge per stone, 10/turn trickle, no boulder cap, grinds
	     anywhere). High-capacity fidget cousin: fidget 2500/easy, this 50000/earned (MaxCharge
	     re-ruled up from 10k mid-build, user: "make the max charge something like 50k and have
	     it usually spawn 1/5th to half full"; StartCharge rolls at creation, base idiom).
	     Acquisition unruled: wish-only for now. -->
	<object Name="Cleo_TerraFirma_GrinderCell" Inherits="Energy Cell">
		<part Name="Render" DisplayName="{{c|grinder}} {{y|cell}}" RenderString="&#231;" ColorString="&amp;c" TileColor="&amp;c" DetailColor="y" Tile="grinder_cell.png" RenderLayer="5" />
		<part Name="EnergyCell" Charge="0" MaxCharge="50000" StartCharge="2500-25000" />
		<part Name="Cleo_TerraFirma_GrinderCell" />
		<part Name="Description" Short="a rumbling spiral milks out bursts of piezoelectric energy from chunks of earth." />
		<part Name="Physics" Weight="5" />
		<part Name="Commerce" Value="100" />
		<part Name="Metal" />
		<tag Name="Tier" Value="3" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>
	<!-- Symbiotic mole cricket (2026-08-22): description USER TEXT FINAL; replaces the Fresh-air
	     trio's attendant chisel (user reflavor). Symbiotic Firefly chassis with DestroyOnUnequip
	     INCLUDED BY RULING - one companion, one goodbye. Behavior in Part_MoleCricket.cs; the
	     *maybe* etch rider stays open. Acquisition unruled: wish-only. User sprite. -->
	<object Name="Cleo_TerraFirma_MoleCricket" Inherits="Item">
		<part Name="Render" DisplayName="symbiotic {{w-y-w-K sequence|mole cricket}}" RenderString="'" ColorString="&amp;w" DetailColor="y" Tile="mole_cricket.png" RenderLayer="5" />
		<part Name="Physics" Organic="true" Weight="1" />
		<part Name="Armor" AV="0" DV="0" WornOn="Floating Nearby" />
		<part Name="Commerce" Value="200" />
		<part Name="Description" Short="a hopping, diminutive thing scrapes idly at the earth. at hindsun it hums, biological processes becoming musical." />
		<part Name="RulesDescription" Text="Sometimes pecks at enemies and scrapes at stone.
Perishes when unequipped." />
		<part Name="Springy" Factor="0.5" />
		<part Name="DestroyOnUnequip" />
		<part Name="Cleo_TerraFirma_MoleCricket" />
		<part Name="AddsRep" Faction="Insects,Cleo_TerraFirma_Quarriers" Value="200" /> <!-- RULED 2026-08-22: +200 each, insects AND the guild - the symbiosis pays both ways -->
		<tag Name="Tier" Value="2" />
		<stag Name="Floating" />
		<tag Name="LiveAnimal" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>
</objects>
