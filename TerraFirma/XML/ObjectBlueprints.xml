  <!-- STONE FIGURINE (2026-08-15). Closes the XML half of the FIGURINE MATERIAL LADDER ruling of
       2026-08-14 (user: "figurines on the floor have a chance to spawn stone (or wood?) instead
       of copper, still giving rep, but very little value"). That ruling was built on the SIM side
       only; the warren lab's own entry still reads "figurine (maquette, mod blueprint TBD)", which
       is sim first working as intended, the lab leading and the XML catching up.
       The engine needed no help. RandomFigurine.Material is a plain string and
       GetFigurineRepValue ends in a default case, so "stone" falls through to DEFAULT_REP_VALUE,
       which is 60: IDENTICAL to copper. So the ruling lands exactly as worded by accident of the
       engine, same social weight, and the "very little value" half is pure Commerce.
       Commerce 3 against copper's 60 is a CLAUDE DRAFT. Display name substitutes *material* so it
       reads "stone <creature> figurine" with no extra work. -->
  <object Name="Cleo_TerraFirma_Random Stone Figurine" Inherits="Random Figurine">
    <part Name="Render" DisplayName="{{y|stone}} {{|*creature*}} figurine" DetailColor="K" RenderString="*" ColorString="&amp;y" RenderLayer="5" />
    <part Name="Commerce" Value="3" />
    <part Name="RandomFigurine" Material="stone" />
    <!-- lang 2.0.212 only replaces =creature.name=, stable only *creature*: this part fills the name in after RandomFigurine on lang (2026-10-19) -->
    <part Name="Cleo_TerraFirma_FigurineCreatureName" />
    <tag Name="Tier" Value="1" />
  </object>
  <!-- The cold dish (same docket + the user's in-game find 2026-08-26: cold-flipped
       dishes kept the flame overlay and lit colors, so they LOOKED lit while silently
       refusing to cook; the old part-strip directive in WarrenCarver died for this).
       A real blueprint in the Campfire/Campfire Remains idiom: no flame prefab, no
       light. Colors stay the ruled brown, USER RULED 2026-08-26 ("no need for the ash
       grey recolor"): cold reads through the dead flames and the name. The tense pass
       and the extinguish path both land here now. Both dish descriptions approved
       2026-09-10. -->
  <object Name="Cleo_TerraFirma_FireDishCold" Inherits="Cleo_TerraFirma_FireDish">
    <part Name="Render" DisplayName="cold fire dish" />
    <part Name="Description" Short="A chunk of earth has been lathed into a finely smoothed bowl. Within it, charred dogthorn cradles the half-spoken echoes of idle chatter." />
    <removepart Name="Campfire" />
    <removepart Name="LightSource" />
    <removepart Name="PrefabImposter" />
  </object>

