    <part Name="Commerce" Value="20" />
    <part Name="Cleo_TerraFirma_FissureStonePart" Level="2" />
    <tag Name="DetonatedSound" Value="Sounds/Throw/sfx_throwing_stone_large_impact" />
    <tag Name="ExcludeFromTurretStock" />
