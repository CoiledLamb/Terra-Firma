  <!-- ===== Painter vertical-slice test objects (2026-07-25). Fire dish and quarried stone descriptions approved 2026-09-08/09-10 (TODO.md). ===== -->
  <!-- Fire dish: inherits Campfire wholesale so the flame VFX come free (AnimatedMaterialFire + PrefabImposter particle flames + LightSource). Tile expects Textures/firedish.png (not yet supplied). -->
  <object Name="Cleo_TerraFirma_FireDish" Inherits="Campfire">
    <!-- USER 2026-08-23: "firepits should be brown or grey (your pick) not red".
         Pick was GREY; SUPERSEDED 2026-08-24, USER RULED BROWN ("fire dish could
         be brown also?", at the shale-recolor sitting). Brown = &w body; detail
         r is the shale family inverted (blocks are &r/w), CLAUDE rendering
         call, strikeable. -->
    <part Name="Render" Tile="firedish.png" DisplayName="carved fire dish" ColorString="&amp;w" TileColor="&amp;w" DetailColor="r" />
    <part Name="Description" Short="A chunk of earth is lathed into a finely smoothed bowl. Twigs of dogthorn crackle faintly, their twisting forms reduced to smoke and ash." />
    <!-- USER 2026-08-23 (fire dish now rolls the dwelling light pool, so both
         were loud): no flash when lit, i.e. Campfire's inherited
         AnimatedMaterialFire strobe goes; the dish is dressed stone, it does
         not flicker as a sprite. The flame overlay (PrefabImposter,
         CampfireFlames) stays, raised to sit in the basin: Y offset is a first
         calibration guess, sign and scale unverified in base XML (no blueprint
         sets it); ONE eyeball iteration expected per the VFX law. -->
    <removepart Name="AnimatedMaterialFire" />
    <part Name="PrefabImposter" Prefab="Prefabs/Particles/CampfireFlames" Y="5" />
    <!-- Extinguish goes to the COLD DISH, not the inherited "Campfire Remains"
         (USER DOCKET 2026-08-26: "fire dishes should work and be placed like
         campfires"): dousing a stone basin should not leave wood ash. -->
    <part Name="Campfire" ExtinguishBlueprint="Cleo_TerraFirma_FireDishCold" />
  </object>

