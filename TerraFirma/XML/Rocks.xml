<!-- Fissure's fallen rocks (Spec v2, 2026-07-22). The v1 fifteen from design/fissure-rock-list.md.
     Thrown channels ride native parts (grenades, BleedingOnHit, DischargeOnHit); step channels and
     pathfinding asymmetry ride Cleo_TerraFirma_FallenRockPart. Crush-on-landing is read from the
     Cleo_TerraFirma_CrushDamage / Cleo_TerraFirma_CrushInstakill tags by the mutation.

     GRIND-FIRST (RULED 2026-07-22): rocks are NOT direct cooking ingredients; the pantry opens
     only through the mill (pestle anywhere, campfire menu, or a millstone). All rock-side
     PreparedCookingIngredient lines were removed that day; the cooking domains live on the
     Ground_* forms at the bottom of this file. The per-rock "Lithovore pass" comments below
     describe each rock's DOMAIN ASSIGNMENT, which its ground form carries. Eaten-effect tags and
     parts (the raw channel) remain rock-side and are unaffected. -->
<objects>
	<!-- BETA HOLD (user ruling 2026-07-27): every spawnable's Description below is commented out
	     (BETA-HELD markers) so unapproved draft text does not ship in the friends beta; rocks fall
	     back to their inherited base-game description. Restore at the real text pass. -->
	<!-- shared base: a throwable stone that fell from the ceiling -->
	<!-- V1 ROCK CATALOG + KITCHEN PARKED on branch quarantine-hold (2026-08-22, user ruling:
	     "move it to its own branch so it doesn't come up until i'm ready to address it").
	     This file keeps the live fissure spine (base fallen rock, pebbles, rubble,
	     crumbled wall, fabric wall) and the held ring pieces (crack, chasm, figure, ape statue,
	     baboon figurine + fists). Generic debris left the spine 2026-08-25 (user: base rocks). The payload stones, puddles, tar patch, ground/kitchen forms,
	     StoneMeal, cooking ingredient mappings, surge field and force shards live on that branch;
	     design record in TODO-quarantine.md. -->
	<object Name="Cleo_TerraFirma_BaseFallenRock" Inherits="BaseStone">
		<!-- Weight 5 -> 1 (user ruling 2026-07-22 verification session): fissure stones are light;
		     a pocketful of ammo shouldn't be half a carry budget. Stalactite overrides back to 5
		     (ruled); pebbles override to 0. KNOWN KNOCK-ON, flagged for veto: the Lithovore's
		     size-scaled satiety keys off weight <= 1, so all fissure rocks now eat as HALF snacks
		     (was: full). Stalactite/boulders/statues unchanged. -->
		<part Name="Physics" Weight="1" Category="Thrown Weapons" />
		<part Name="Commerce" Value="1" />
		<!-- THE DISCHARGE LAW (fragility system RULED 2026-07-25, supersedes HoldChance-25 and the
		     dull clock): a stone keeps until it goes off; it always goes off underfoot (spenders
		     carry StepChance 100) unless the stepper is its owner or the owner's party; when it
		     goes off (step or throw) it is gone (HoldChance 0). Payloadless ammo never spends.
		     Zoners (caromcobble 50, crack 15) keep per-crossing RATES and HoldChance 100;
		     permanence is their identity. Dull clock CUT same ruling (weight is the carry cap,
		     Burgeoning the precedent; DullAfter 0 = never, the code path stays for a future longer
		     fuse). Children's part lines merge over this one. -->
		<part Name="Cleo_TerraFirma_FallenRockPart" HoldChance="0" DullAfter="0" />
		<tag Name="BaseObject" Value="*noinherit" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Tier" Value="1" />
	</object>

	<!-- ============ Band 1 (mutation Lv 1-3) ============ -->


	<object Name="Cleo_TerraFirma_Rock_Pebbles" Inherits="Cleo_TerraFirma_BaseFallenRock">
		<part Name="Render" DisplayName="pebbles" Tile="Items/sw_smallstone.bmp" ColorString="&amp;w" DetailColor="Y" />
		<!-- BETA-HELD: <part Name="Description" Short="Smooth spall from the world's slow grinding, come down at last." /> -->
		<part Name="Physics" Weight="0" /> <!-- user asked 0.1; engine Weight is an int, so 0 is the nearest (powder precedent) -->
		<tag Name="Gender" Value="plural" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="1" />
	</object>
	<!-- (russet/blue pebble variants CUT, user ruling 2026-07-22) -->

	<!-- (russet/blue pebble variants CUT, user ruling 2026-07-22) -->

	<!-- (Rock_Generic "fallen rock" DELETED, user ruling 2026-08-25 "remove em":
	     base rocks serve everywhere it spawned. Dress: Small Stone/SmallBoulder;
	     fissure debris: SmallBoulder. Its 2d6 CrushDamage left with it.) -->

	<!-- THE HOLOGRAPHIC ROCK (user concept 2026-07-24, designed + ruled 2026-07-25): the rock
	     that isn't there. Belief gates both ends (Part_Holographic: Int DC 12, sticky forever,
	     machines auto-pass); a believed hit does EXACTLY a generic rock's dice (the mundanity is
	     the punchline) and collapses the lie. Generics of tiers 2-3 at weight 5 ("it's just a
	     joke rock, so it's pretty weak... it should also not get picked for seams"); NoSeam tag
	     enforced at the Fissure seam roll. No CrushDamage tag: a fall that isn't there crushes
	     no one. Excluded from the strange pool (purity invariant: a belief gate can no-op).
	     Neither mill nor pestle yields anything (machines don't believe; believers grind at
	     nothing). Render shimmer = HologramMaterial, the tell for the observant. Name WIP,
	     queued behind the tanglelith slate; description DRAFT (user's surface). -->

	<object Name="Cleo_TerraFirma_Rock_Rubble" Inherits="Rubble">
		<part Name="Render" DisplayName="rubble" ColorString="&amp;y" DetailColor="w" />
		<!-- BETA-HELD: <part Name="Description" Short="A volume of the ceiling lies where it landed, broken past any use but blocking the way all the same." /> -->
		<stat Name="Hitpoints" Value="250" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="3d6" />
	</object>

	<!-- ============ Rock-scale puddles (pool-volume ruling 2026-07-24; revised same day from
	     2d8 to 4d8, so 4-32 drams) ============
	     The base puddles spawn at a flat 500 drams and render as "pool of X" (a water source
	     from a pebble); base OilPuddle's own StartVolume idiom is the fix pattern. These children
	     override spawn volume only; everything else inherits. The pour-into-container park item
	     draws from the same 2d8 budget. -->

	<object Name="Cleo_TerraFirma_Rock_CrumbledWall" Inherits="Rubble">
		<part Name="Render" DisplayName="crumbled wall" ColorString="&amp;Y" DetailColor="y" />
		<!-- BETA-HELD: <part Name="Description" Short="A slab too broken to stand and too stubborn to lie flat." /> -->
		<stat Name="Hitpoints" Value="400" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="5d6" />
	</object>

	<object Name="Cleo_TerraFirma_RedoubtFigure" Inherits="Statue">
		<part Name="Render" DisplayName="stone figure" RenderString="|" ColorString="&amp;y" DetailColor="K" Occluding="true" Tile="Terrain/tile_tombstone1.png" RenderLayer="6" />
		<!-- BETA-HELD (DRAFT): <part Name="Description" Short="The wave left this behind: a shape half-risen from the earth, worked by no hand you could name." /> -->
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>


	<object Name="Cleo_TerraFirma_Rock_Wall" Inherits="Sandstone">
		<part Name="Render" DisplayName="fallen wall" />
		<!-- BETA-HELD: <part Name="Description" Short="A shelf of the deep ceiling, standing now where it fell, load-bearing for nothing." /> -->
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="8d8" />
		<tag Name="Cleo_TerraFirma_CrushInstakill" Value="15" />
		<!-- seam fix (user 2026-08-05: "fissure walls don't seem to paint with calcify walls"):
		     the painter only fuses same-blueprint / matching-PaintWith / neighbor-wildcard /
		     PaintPart-hit neighbors, and this blueprint matched calcify's zone-borrowed stone on
		     none of them. PaintPart makes THIS wall draw fused toward anything carrying the mod's
		     stone part (calcify walls, zone geology; Merges.xml puts it on all natural rock);
		     PaintWith "*" is the engine wildcard making neighbors draw fused toward THIS wall.
		     Both directions covered = no broken faces at the joint. -->
		<tag Name="PaintWith" Value="*" />
		<tag Name="PaintPart" Value="Cleo_TerraFirma_StoneshaperWallProperties" />
	</object>

	<object Name="Cleo_TerraFirma_BaboonFigurineItem" Inherits="Trinket">
		<part Name="Render" DisplayName="baboon figurine" Tile="Assets_Content_Textures_Creatures_sw_baboon.bmp" RenderString="]" ColorString="&amp;y" DetailColor="K" />
		<!-- BETA-HELD (DRAFT): <part Name="Description" Short="A baboon no taller than a knee, carved by patient hands. It holds very still, the way stone remembers to." /> -->
		<part Name="Physics" Weight="5" />
		<part Name="Commerce" Value="30" />
		<!-- WorksOnCarrier: without it AddsRep is equipper-only and a trinket is never equipped
		     (harness quick.rep, delta 0). Examiner override: base Trinket demands identification;
		     a carved baboon is self-evident (user flag 2026-07-24). -->
		<part Name="AddsRep" Faction="Baboons" Value="200" WorksOnCarrier="true" />
		<part Name="Examiner" Complexity="0" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>


	<object Name="Cleo_TerraFirma_Rock_ApeStatue" Inherits="BaseApe">
		<part Name="Render" DisplayName="ape statue" RenderString="a" Tile="Creatures/albino-ape.png" ColorString="&amp;y" DetailColor="K" />
		<!-- BETA-HELD (DRAFT): <part Name="Description" Short="An ape rendered in stone by no sculptor anyone can name. It moves like it remembers being one or the other." /> -->
		<part Name="Brain" Hostile="false" />
		<stat Name="Level" Value="12" />
		<!-- stone body (user ruling 2026-07-22): +2 AV over the flesh original, and acid eats stone.
		     AcidResistance -50 is a Claude number (base-game fungi anchor: -10) -->
		<stat Name="AV" Value="7" />
		<stat Name="AcidResistance" Value="-50" />
		<stat Name="Hitpoints" Value="29" />
		<inventoryobject Blueprint="Cleo_TerraFirma_StoneApeFist" Number="2" /> <!-- stone mimicry of the natural weapon (user ruling 2026-07-22) -->
		<skill Name="Cudgel" />
		<skill Name="Cudgel_Bludgeon" />
		<tag Name="Role" Value="Brute" />
		<part Name="Corpse" CorpseChance="0" />
		<part Name="MentalShield" />
		<part Name="NoBleed" />
		<!-- RULED 2026-07-24 (revises the PERMANENT ratify: "ape can have cooldown"): a lifespan,
		     then it crumbles back to devourable rubble where it stands -->
		<part Name="Cleo_TerraFirma_TimedForm" Duration="500-1000" ReplacementBlueprint="Cleo_TerraFirma_Rock_Rubble" ExpireVerb="crumble" ExpireRest="back to rubble." />
		<tag Name="DeathSounds" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_die" />
		<tag Name="TakeDamageSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_hurt" />
		<tag Name="AmbientIdleSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_idle" />
		<tag Name="PunchSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_attack" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Species" Value="statue" />
	</object>

	<!-- stone mimicry of natural weapons (user ruling 2026-07-22): form and dice of the flesh
	     original, rendered in stone -->
	<object Name="Cleo_TerraFirma_StoneApeFist" Inherits="Albino ape fist">
		<part Name="Render" DisplayName="stone fist" ColorString="&amp;y" DetailColor="K" />
	</object>
	<object Name="Cleo_TerraFirma_StoneBaboonBite" Inherits="Baboon_Bite">
		<part Name="Render" DisplayName="stone bite" ColorString="&amp;y" DetailColor="K" />
	</object>

	<!-- baboon figurine (#21) Ã¢â‚¬â€ CREATURE-FIRST redesign (user rulings 2026-07-22): a knee-high stone
	     baboon that falls alive and allied (DropRock brain-branch), fights at RANGE with real fissure
	     stones (standard baboon loadout + pocket line; AIThrowAndScoot inherited from BaseBaboon is
	     the whole skirmish AI), and scavenges spent stones off the floor (StoneScavenger Ã¢â‚¬â€ it picks
	     up your fissure fallout and throws it back for you). Baboon base stats per ruling (L5/HP5/AV2:
	     small, weak, dies if cornered); the identity is the ARM Ã¢â‚¬â€ range/accuracy via actor properties,
	     not Strength (weak arm, uncanny aim; both Claude numbers). PERMANENT (ruled). Pickup, carrying,
	     inventory activation, and rep are the auxiliary pocket-form pass Ã¢â‚¬â€ deliberately NOT built yet. -->
	<object Name="Cleo_TerraFirma_Rock_BaboonFigurine" Inherits="BaseBaboon">
		<!-- "statuette" not "figurine" (user ruling 2026-07-22): base-game Figurines are inert trade
		     goods and this is anything but. Internal blueprint name unchanged, house pattern. -->
		<!-- StoneStep tag RETIRED 2026-07-25 (fragility ruling): seam-born creatures land allied to
		     the caster, so the owner-party gate covers them ("no carveout just for baboons"). The
		     deferred stone-creature roster conversation may resurrect the tag for WILD stone
		     creatures (stonefrog etc.) if party status ever isn't enough. -->
		<part Name="Render" DisplayName="baboon statuette" Tile="Assets_Content_Textures_Creatures_sw_baboon.bmp" RenderString="a" ColorString="&amp;y" DetailColor="K" />
		<!-- BETA-HELD (DRAFT): <part Name="Description" Short="A baboon no taller than a knee, carved by patient hands and impatient to be moving. It sizes up everything as either a threat or a throw." /> -->
		<part Name="Brain" Hostile="false" />
		<stat Name="Level" Value="5" />
		<!-- stone body (user ruling 2026-07-22): +2 AV over BaseBaboon's 2, and acid eats stone -->
		<stat Name="AV" Value="4" />
		<stat Name="AcidResistance" Value="-50" />
		<inventoryobject Blueprint="Cleo_TerraFirma_StoneBaboonBite" Number="1" />
		<inventoryobject Blueprint="Small Stone" Number="5" />
		<inventoryobject Blueprint="@Cleo_TerraFirma_ThrowableRocks1" Number="1-2" />
		<part Name="Cleo_TerraFirma_StoneScavenger" />
		<!-- RULED 2026-07-24 ("same for baboon... when baboon expires, maybe make it into that rep
		     granting figure"): lifespan, then it stiffens into the AddsRep figurine item (the
		     catalog's original rep half, finally landing); pocket stones spill on expiry -->
		<part Name="Cleo_TerraFirma_TimedForm" Duration="500-1000" ReplacementBlueprint="Cleo_TerraFirma_BaboonFigurineItem" ExpireVerb="stiffen" ExpireRest="back into a lifeless figurine." />
		<intproperty Name="ThrowRangeBonus" Value="5" />
		<intproperty Name="CloseThrowRangeAccuracyBonus" Value="50" />
		<part Name="Corpse" CorpseChance="0" />
		<part Name="MentalShield" />
		<part Name="NoBleed" />
		<removepart Name="BloodRingWeakness" />
		<tag Name="Role" Value="Artillery" />
		<tag Name="DynamicObjectsTable:Baboons" Value="{{{remove}}}" />
		<tag Name="DeathSounds" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_die" />
		<tag Name="TakeDamageSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_hurt" />
		<tag Name="AmbientIdleSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_idle" />
		<tag Name="PunchSound" Value="Sounds/Creatures/VO/sfx_creature_animal_rockCreature_vo_attack" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Species" Value="statue" />
	</object>

	<object Name="Cleo_TerraFirma_Rock_Crack" Inherits="StairsDown">
		<part Name="Render" DisplayName="cracked floor" Tile="Terrain/sw_crack.bmp" ColorString="&amp;K" TileColor="&amp;y" DetailColor="K" RenderString="." />
		<!-- BETA-HELD (DRAFT): <part Name="Description" Short="A hairline parting in the floor, wide enough to have opinions about weight." /> -->
		<part Name="StairsDown" Connected="false" PullDown="false" PullMessage="The floor gives way!" />
		<part Name="StairHighlight" bEnabled="false" />
		<removepart Name="Interesting" />
		<part Name="Cleo_TerraFirma_FallenRockPart" StepChance="15" Payload="FallThrough" HoldChance="100" />
		<tag Name="NoAutowalk" />
		<tag Name="IgnoreForStairConnections" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Gender" Value="neuter" />
	</object>

	<!-- chasm: band-3 rare, the overt counterpart. A true open hole (native OpenShaft machinery:
	     always-pull, everyone natively avoids it, and whatever occupies the cell it lands in falls
	     straight through, loose loot included; that is its crush). Zero mod code. -->
	<object Name="Cleo_TerraFirma_Rock_Chasm" Inherits="OpenShaft">
		<part Name="Render" DisplayName="chasm" />
		<!-- BETA-HELD (DRAFT): <part Name="Description" Short="The collapse kept going. Below is only more below." /> -->
		<part Name="StairsDown" PullMessage="You plunge through the broken floor!" />
		<tag Name="ExcludeFromDynamicEncounters" />
	</object>

</objects>
