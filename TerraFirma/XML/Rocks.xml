<?xml version="1.0" encoding="utf-8" ?>
<!-- What Fissure places: loose pebbles in the wave's wake, and the ring's fabric (rubble,
     crumbled wall, fallen wall). Mutation_Fissure.cs reads Cleo_TerraFirma_CrushDamage and
     Cleo_TerraFirma_CrushInstakill from these blueprints when a piece lands on someone.
     The v1 rock catalog, its kitchen and Lithovore are held on the quarantine-hold branch and
     in quarantine/ (2026-09-30); design record in TODO-quarantine.md. -->
<objects>
	<object Name="Cleo_TerraFirma_Rock_Pebbles" Inherits="BaseStone">
		<part Name="Render" DisplayName="pebbles" Tile="Items/sw_smallstone.bmp" ColorString="&amp;w" DetailColor="Y" />
		<part Name="Description" Short="Smooth spall from the world's slow grinding, come down at last." /> <!-- draft, approved 2026-09-30 -->
		<part Name="Physics" Weight="0" Category="Thrown Weapons" /> <!-- user asked 0.1; engine Weight is an int, so 0 is the nearest (powder precedent) -->
		<part Name="Commerce" Value="1" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Tier" Value="1" />
		<tag Name="Gender" Value="plural" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="1" />
	</object>

	<object Name="Cleo_TerraFirma_Rock_Rubble" Inherits="Rubble">
		<part Name="Render" DisplayName="rubble" ColorString="&amp;y" DetailColor="w" />
		<stat Name="Hitpoints" Value="250" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="3d6" />
	</object>

	<object Name="Cleo_TerraFirma_Rock_CrumbledWall" Inherits="Rubble">
		<part Name="Render" DisplayName="crumbled wall" ColorString="&amp;Y" DetailColor="y" />
		<stat Name="Hitpoints" Value="400" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="5d6" />
	</object>

	<object Name="Cleo_TerraFirma_Rock_Wall" Inherits="Sandstone">
		<part Name="Render" DisplayName="fallen wall" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Cleo_TerraFirma_CrushDamage" Value="8d8" />
		<tag Name="Cleo_TerraFirma_CrushInstakill" Value="15" />
		<!-- Fuses with calcify walls and zone geology (user 2026-08-05): PaintPart makes this wall
		     draw toward anything carrying the mod's stone part (Merges.xml puts it on all natural
		     rock), and PaintWith "*" makes neighbors draw toward this wall. -->
		<tag Name="PaintWith" Value="*" />
		<tag Name="PaintPart" Value="Cleo_TerraFirma_StoneshaperWallProperties" />
	</object>
</objects>
