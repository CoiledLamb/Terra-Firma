	<object Name="BaseStone" Load="Merge">
		<tag Name="Cleo_TerraFirma_IsAnyStone" />
		<part Name="Cleo_TerraFirma_GeomancyStonePart" />
	</object>
	<object Name="Gemstone" Load="Merge">
		<tag Name="Cleo_TerraFirma_IsAnyStone" />
		<tag Name="Cleo_TerraFirma_IsGemstone" />
		<part Name="Cleo_TerraFirma_GeomancyStonePart" />
		<!-- RULED 2026-07-25 (user: "we would have to add the behavior for them to be thrown
		     slot, but i think that's a good idea"): gemstones are first-class Geomancy ammo, so
		     default equip should pick the Thrown Weapon slot - which the engine does for any
		     ThrownWeapon-part item. Damage 1d2 = Small Stone parity, DRAFT for ratify. Watch
		     item: creatures holding gems can now ready and throw them. -->
		<part Name="ThrownWeapon" Damage="1d2" />
	</object>
	<!-- Trade goods work for Geomancy (user ruling 2026-08-06: "trade goods (nuggets and
	     figurines) should work for geomancy. it's a great tutorial for the mechanic when you
	     start stonecarver"). The tag is NARROW on purpose: IsAnyStone is load-bearing elsewhere
	     (lithovore food gate, EB auto-sculpt after throwing any stone), so trade goods carry a
	     Geomancy-only pass instead. Power = max(weight, value) already favors them; a gold
	     nugget reveals wide. BaseNugget covers copper/silver/gold; Random Figurine covers the
	     whole figurine family by inheritance. -->
	<object Name="BaseNugget" Load="Merge">
		<tag Name="Cleo_TerraFirma_IsGeomancyStone" />
		<part Name="Cleo_TerraFirma_GeomancyStonePart" />
	</object>
	<object Name="Random Figurine" Load="Merge">
		<tag Name="Cleo_TerraFirma_IsGeomancyStone" />
		<part Name="Cleo_TerraFirma_GeomancyStonePart" />
	</object>
