	<!-- Baboons and fissure stones (user rulings 2026-07-22, refined same day): only the basic
	     early-game family. Merging on "Baboon" reaches Hulking/Shrewd/Hero by inheritance but NOT
	     Quartz Baboon (which inherits BaseBaboon directly). Number="1-2" = 1 guaranteed, a second
	     half the time; the bigger baboons override to 2-3 to show their strength. The scavenger part
	     makes them fetch spent stones instead of settling for melee (enemy-closer-than-stone wins). -->
	<!-- Stone milling (RULED 2026-07-22): one part, two homes. On the Campfire, the cooking menu
	     grows "Grind stones with your pestle" (GetCookingActionsEvent dispatches to the campfire
	     object; it does NOT cascade into inventory, so the pestle alone can't hear it there). On
	     the Pestle (the base game's own jobless stone cudgel, now employed) "grind stones" is
	     available anywhere, no campfire, no skill: the tool is the gate. -->
	<object Name="Campfire" Load="Merge">
		<part Name="Cleo_TerraFirma_StoneMill" />
	</object>
	<object Name="Pestle" Load="Merge">
		<part Name="Cleo_TerraFirma_StoneMill" />
	</object>
	<!-- the base Millstone (Joppa's mill, which already grinds glands into pastes) grinds stones
	     with no pestle in hand; the furniture IS the tool (user ruling 2026-07-22). Note: the
	     native Mill part is mechanically powered; our menu deliberately does not require power
	     (stones are hand-turned work), flagged for veto at verify. -->
	<object Name="Millstone" Load="Merge">
		<part Name="Cleo_TerraFirma_StoneMill" RequiresPestle="false" />
	</object>
	<object Name="Baboon" Load="Merge">
		<part Name="Cleo_TerraFirma_StoneScavenger" />
		<inventoryobject Blueprint="@Cleo_TerraFirma_ThrowableRocks1" Number="1-2" />
	</object>
	<object Name="Hulking Baboon" Load="Merge">
		<inventoryobject Blueprint="@Cleo_TerraFirma_ThrowableRocks1" Number="2-3" />
	</object>
	<object Name="Shrewd Baboon" Load="Merge">
		<inventoryobject Blueprint="@Cleo_TerraFirma_ThrowableRocks1" Number="2-3" />
	</object>
</objects>
