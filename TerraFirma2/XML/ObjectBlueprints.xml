  <!-- Quarried block: RandomTile builder rotates the three user sprites. -->
  <!-- Quarry stone stacks (warren dress port 2026-08-23): the yard's three
       grades, user sprites (quarrystones 1a/1b through 3a/3b). Grade 1 is the
       column being filled NOW, grade 3 is finished stock; the yard recipe reads
       time through them (fill ordering RULED 2026-07-27). DisplayName draft, approved 2026-09-30;
       descriptions deliberately absent, ride the release text pass. -->
  <!-- Moss clump (USER RULED 2026-08-23: wall moss is harvestable, wall reverts).
       Mirrors base's own Clump of Grave Moss (a Snack): tile is that clump
       RECOLORED PLACEHOLDER (sprite debt filed, house convention); description
       absent for the release pass. NAME FORMAT USER-RULED same day ("clump of
       (dark grey)cave(green)moss" - no space, split-colored); dark grey mapped
       to the K code, CLAUDE rendering call, strikeable. COOKING: gets an effect
       later per the user - only the lithovore cooking conversation is benched;
       this item's effect is planned work, not quarantined. -->
  <object Name="Cleo_TerraFirma_MossClump" Inherits="Snack">
    <part Name="Render" DisplayName="clump of {{K|cave}} {{green|moss}}" ColorString="&amp;g" DetailColor="K" RenderString="%" Tile="Items/sw_grave_moss_clump.bmp" />
    <part Name="Description" Short="A glistening carpet of moss holds the earth in its folds. Grit coats its tufts, promising the texture of salted pebbles." />
    <part Name="Physics" Weight="1" Organic="true" />
    <part Name="Commerce" Value="1" />
    <part Name="Food" Satiation="Snack" Message="It's like eating salted grit, with a loamy aftertaste." /> <!-- user text 2026-09-29 -->
    <!-- base Clump of Grave Moss -> Crushed Grave Moss, 3 per clump (Foods.xml:510) -->
    <part Name="PreservableItem" Result="Cleo_TerraFirma_CrushedCaveMoss" Number="3" />
    <tag Name="ExcludeFromDynamicEncounters" />
  </object>

  <!-- CRUSHED CAVE MOSS (2026-09-29): the cooking ingredient, base Crushed Grave Moss shape
       (Foods.xml:847). Name, description and sprite user-supplied; grey container matches Starapple Preserves' TileColor &amp;y (base
       grave-moss tile retired 2026-09-29). World ingredient tables are the
       shale biomes, Hills and DesertCanyon (Hills.cs, Redrock.cs), like Starapple Preserves. -->
  <object Name="Cleo_TerraFirma_CrushedCaveMoss" Inherits="Preservable">
    <part Name="Render" DisplayName="crushed {{K|cave}} {{green|moss}}" RenderString="%" ColorString="&amp;g" TileColor="&amp;y" DetailColor="K" RenderLayer="5" Tile="crushedcavemoss.png" />
    <part Name="Description" Short="A blanket of verdant moss was plucked from its swaddlehome, ground in a mortar, and interred in a glass vessel." /> <!-- user text 2026-09-29 -->
    <part Name="Commerce" Value="2" />
    <part Name="PreparedCookingIngredient" type="Cleo_TerraFirma_caveMoss" charges="1" />
    <tag Name="Plant" />
    <tag Name="DynamicObjectsTable:Hills_Ingredients" />
    <tag Name="DynamicObjectsTable:DesertCanyon_Ingredients" />
  </object>

  <!-- The cooked moss pebble: Earthen Barrage's sculpted pebble with its placeholder
       damage pinned as real numbers, so Barrage edits cannot change the meal (1d8, PV 4,
       30-turn expiry inherited). Not IsOurStone, so Barrage scaling never touches it. -->
  <object Name="Cleo_TerraFirma_MossPebble" Inherits="Cleo_TerraFirma_EphemeralStone">
    <part Name="ThrownWeapon" Penetration="4" Damage="1d8" Attributes="Cudgel" />
  </object>

  <!-- Cave moss cooking domain. The engine requires this exact name shape
       (ProceduralCookingIngredient_ + type), so the Cleo_TerraFirma_ prefix sits in the type.
       Weights copy regenLowtier (Data.xml:341); menu text copies base phrasing. -->
  <object Name="ProceduralCookingIngredient_Cleo_TerraFirma_caveMoss" Inherits="IngredientMapping">
    <tag Name="CookingDomain" Value="Cleo_TerraFirma_caveMoss" />
    <tag Name="Units" Value="Cleo_TerraFirma_CookingDomainCaveMoss_UnitEarthenBarrage" />
    <tag Name="Triggers" Value="Cleo_TerraFirma_CookingDomainCaveMoss_OnThrowStone" />
    <tag Name="Actions" Value="Cleo_TerraFirma_CookingDomainCaveMoss_Pebble_ProceduralCookingTriggeredAction" />
    <tag Name="Description" Value="stone-based" />
    <tag Name="RandomWeight" Value="10" />
    <tag Name="RandomHighTierWeight" Value="0" />
  </object>

  <!-- trail cairn (user float 2026-08-24, sprites landed 2026-08-25). cairn1 is the
       STANDING stack, cairn2 the toppled scatter; the first cut wrongly rolled both as
       RandomTile variants (user flag 2026-08-25). Shale colors and both descriptions are
       USER TEXT FINAL 2026-08-25. -->
  <object Name="Cleo_TerraFirma_Cairn" Inherits="Furniture">
    <!-- colors swapped w/r (user note 1, 2026-08-25) -->
    <part Name="Render" Tile="cairn1.png" DisplayName="cairn" RenderString="007" ColorString="&amp;w" TileColor="&amp;w" DetailColor="r" Occluding="false" />
    <part Name="Description" Short="A waystone for those with eyes to the earth, this stack of rocks inhabits an unresolved superposition of endurance and fragility." />
    <!-- walkable ON PURPOSE (user docket 2026-08-25): it topples when stepped on, so it
         must be steppable; the topple part carries the ownership trespass channel -->
    <part Name="Physics" Solid="false" Takeable="false" Weight="400" />
    <part Name="Cleo_TerraFirma_CairnTopple" />
    <tag Name="ExcludeFromDynamicEncounters" />
    <tag Name="NoSparkingQuest" />
  </object>
  <object Name="Cleo_TerraFirma_CairnToppled" Inherits="Cleo_TerraFirma_Cairn">
    <part Name="Render" Tile="cairn2.png" DisplayName="toppled cairn" RenderString="007" ColorString="&amp;w" TileColor="&amp;w" DetailColor="r" Occluding="false" />
    <part Name="Description" Short="These scattered rocks once formed a waystone; now, only traces of their former order remain." />
    <part Name="Physics" Solid="false" Takeable="false" Weight="400" />
    <!-- already fallen: inheriting the topple part made stepping on the scatter
         print a second topple (user note 2, 2026-08-25) and re-topple forever -->
    <removepart Name="Cleo_TerraFirma_CairnTopple" />
    <part Name="Cleo_TerraFirma_CairnRestack" /> <!-- B09 2026-09-29: restack to standing, owner kept, no rep effect -->
  </object>

  <!-- WARREN BASKETS (port debt paid 2026-08-26; the two tables are USER-RULED 2026-08-18:
       "we could make our own pop tables - one for stones (baskets of earth), and one for
       canyon specific preserved foods (yuckwheat, starapples jam, boar jerky)"). The
       Preserved Food Basket idiom exactly (base Furniture.xml:4001): inherit Woven Basket,
       add one InventoryPopulationTable tag; GameObjectFactory fills the inventory from the
       named table at spawn (engine rng, same as vase glazes rolling per spawn). Render and
       name stay the plain basket's on purpose: which basket it is, you learn by opening it.
       Contents tables live in PopulationTables.xml beside the warren dress tables. -->
  <object Name="Cleo_TerraFirma_Stone Basket" Inherits="Woven Basket">
    <tag Name="InventoryPopulationTable" Value="Cleo_TerraFirma_StoneBasket Contents" />
  </object>
  <object Name="Cleo_TerraFirma_Food Basket" Inherits="Woven Basket">
    <tag Name="InventoryPopulationTable" Value="Cleo_TerraFirma_FoodBasket Contents" />
  </object>

  <!-- YARD LEDGER BOARD (setup USER-greenlit 2026-08-26: "that sounds fine, set that up").
       The dress yard's chalkboard as its own blueprint, so the ledger LINES live here as
       tags instead of C# strings; the =token= substitution style is the game's own
       vernacular. The lines are the 2026-08-23 draft, approved 2026-09-30;
       editing these Values needs no recompile. Tokens the
       carver fills: =day= and =month= (Calendar, at carve time), =blocks= (the site's true
       carved floor, so the board never lies about the dig it stands in). WarrenCarver
       keeps deciding WHICH lines appear (the occupancy law); the write-verb part arrives
       through the base Chalkboard merge in Merges.xml, the writing part is declared
       here so the carver no longer bolts it on in code. -->
  <object Name="Cleo_TerraFirma_Yard Board" Inherits="Chalkboard">
    <part Name="Cleo_TerraFirma_ChalkWriting" />
    <tag Name="Cleo_TerraFirma_ArrivedLine" Value="arrived the =day= of =month=" />
    <tag Name="Cleo_TerraFirma_DepartedLine" Value="departed the =day= of =month=" />
    <tag Name="Cleo_TerraFirma_TallyLine" Value="=blocks= blocks raised" />
  </object>

  <!-- QUARRY CHEST (gear sitting 2026-08-23; user ruling: "making it a generalized loot table
       that merchant tables and chests can roll makes sense"). The MiningGear consumer for
       PLACED loot: a Chest variant whose inventory rolls the table, on the ChestBronzeIngots
       grammar (base Furniture.xml:3521, inherit Chest + inventoryobject lines). The @-table
       roll syntax is the templar-grenades idiom from creature inventories; the inventoryobject
       parser is shared across blueprint types, verify-at-boot item filed. Contents rhyme with
       the quarrier spine on purpose: the stash holds what the crew carries. The warren
       dressing places this in the socket, gallery-bay, and room-storage chest rolls.
       The room-storage chest cap counts this variant too. Vine merchant
       restock joins when that blueprint lands (intent recorded in TODO.md). Counts and
       chances CLAUDE DRAFT. Reads as a plain chest (own name dropped 2026-09-30, user). -->
  <object Name="Cleo_TerraFirma_Quarry Chest" Inherits="Chest">
    <part Name="Inventory" />
    <inventoryobject Blueprint="@Cleo_TerraFirma_MiningGear" Number="1-2" />
    <inventoryobject Blueprint="Pickaxe" Chance="35" />
    <inventoryobject Blueprint="Torch" Number="1-3" Chance="50" />
  </object>

  <!-- FISSURE STONE (built 2026-08-23; pitch is the USER'S, "rocks that when thrown, make a
       fissure detonation at the center of their tile, then are destroyed"; RULED same day:
       payload is the pulses only, never the redoubt ring; Level 2, so 3d4/2d3/1d3 dice, stun 1
       round at DC 16; 2-3 per hewer in the kit). Grammar is the goatfolk sower's seed exactly
       (base Creatures.xml:4663): BaseThrownWeapon plus an IGrenade part in plain inventory, no
       AI part needed, stock combat AI throws it, AfterThrownEvent detonates it at the landing
       cell and the part destroys the stone after. PV rides the thrower's Strength mod per the
       fissure grammar, so a looted stone scales with whoever throws it while the dice stay
       pinned. No Examiner: carved stone, understood on sight. DetonatedSound is Fissure's own
       verified slam. Tile is the fallen-rock family's, kin to what the detonation scatters.
       FLAVOR NOTE 2026-08-24: a "lump of primordial clay" pass landed here for a few hours by
       misread; the user meant it for the FIGURINE grenade (unbuilt, see TODO roster flags).
       Name and description here are CLAUDE GUT by the user's license ("go with your gut and
       i'll edit it later however i desire"), so both are freely editable, no signoff gate.
       Commerce and Weight CLAUDE DRAFT. -->
  <object Name="Cleo_TerraFirma_FissureStone" Inherits="BaseThrownWeapon">
    <part Name="Render" DisplayName="fissure stone" Tile="Items/sw_smallboulder.bmp" RenderString="*" ColorString="&amp;y" DetailColor="K" />
    <part Name="Description" Short="A fist of quarried stone, scored to a lattice of fault lines. It is waiting for one hard landing." /> <!-- CLAUDE GUT, user edits at will -->
    <part Name="Stacker" />
    <part Name="Physics" Category="Grenades" Weight="10" />
    <part Name="Commerce" Value="20" />
    <part Name="Cleo_TerraFirma_FissureStonePart" Level="2" />
    <tag Name="DetonatedSound" Value="Sounds/Throw/sfx_throwing_stone_large_impact" />
    <tag Name="ExcludeFromTurretStock" />
  </object>

  <!-- PROPER ETCH TOOLS thread RETIRED 2026-08-22 (user: "let's remove the added chisels and
