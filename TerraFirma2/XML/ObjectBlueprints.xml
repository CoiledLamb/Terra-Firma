<objects>
    <!-- Cobblefur family (settled 2026-08-13 sitting): the cobble baboon's butchery drops,
       quartz/quartzfur grammar (user's catch: "-fur" is base's loot-contract suffix).
       All three: Fur part + organic + AddsRep Baboons -100 per piece (quartzfur precedent;
       wearing dead monkey angers living monkeys, stacks per piece worn = self-balancing).
       Tiles are recolored base PLACEHOLDERS, sprite debt filed for all three.
       Numbers DRAFT (numbers sitting) except gloves Chance 50 (user 2026-09-30, up from 25); cloak conditional DV 2
       (Yurtmat parity), commerce/tier modest; bracer is +2 throw range, USER NUMBER
       2026-08-22 (see the bracer's own comment below). Descriptions are user text 2026-09-29. -->
    <object Name="Cleo_TerraFirma_Cobblefur Bracer" Inherits="BaseArmlet">
    <part Name="Armor" AV="0" DV="0" WornOn="Arm" />
    <part Name="Render" DisplayName="{{y|granitefur}} bracer" RenderString="]" Tile="baboonskin_bracers.png" ColorString="&amp;r" DetailColor="y" /> <!-- user sprite 2026-08-22; rust/brown per the cloak ruling, family palette -->
    <part Name="Commerce" Value="40" /> <!-- user 2026-10-03, rough -->
    <part Name="Description" Short="Grit-caked flesh was carved from a dead baboon and woven into a bracer." /> <!-- USER TEXT 2026-09-29, quartzfur echo -->
    <part Name="Physics" Weight="1" Organic="true" />
    <part Name="Fur" />
    <!-- MIGRATED to stock IntPropertyChanger 2026-08-29 (XML over C# ladder pass); the custom
         Cleo_TerraFirma_CobblefurBracer part is deleted. Provenance carried over from its header:
         +2 throw range is USER NUMBER 2026-08-22 ("swap the bonus to +2 throw range and dodge the
         problem altogether"), replacing the old cap-aware accuracy lend after the accuracy exam
         found an order-dependent overflow. ThrowRangeBonus is linear (GetThrowProfileEvent reads
         the int property straight into Range), safe to stack; same property family as the
         Parabolic Muscular Subroutine, whose BehaviorDescription phrasing this reuses.
         NOTE: the old XML here said Bonus="25", a stale survivor of the pre-rework accuracy
         number; the live game was granting +25 throw range against the ruled +2. Caught and
         corrected in this migration, 2026-08-29. -->
    <part Name="IntPropertyChanger" AffectedProperty="ThrowRangeBonus" Amount="2" ChargeUse="0" IsEMPSensitive="false" IsBootSensitive="false" IsTechScannable="false" MustBeUnderstood="false" BehaviorDescription="Your throw range is increased by 2." />
    <part Name="AddsRep" Faction="Baboons" Value="-100" />
    <tag Name="EquipSound" Value="sfx_equip_armor_fur" />
    <tag Name="Tier" Value="2" />
  </object>
    <object Name="Cleo_TerraFirma_Cobblefur Gloves" Inherits="BaseGlove">
    <part Name="Armor" AV="0" DV="1" WornOn="Hands" />
    <part Name="Render" DisplayName="{{y|granitefur}} gloves" RenderString="]" Tile="catching_gloves.png" ColorString="&amp;r" DetailColor="y" /> <!-- user sprite 2026-08-22 -->
    <part Name="Commerce" Value="50" /> <!-- user 2026-10-03, rough -->
    <part Name="Description" Short="Grit-caked flesh was carved from a dead baboon and sewn into a pair of gloves." /> <!-- USER TEXT 2026-09-29, quartzfur echo -->
    <part Name="Physics" Weight="5" Organic="true" />
    <part Name="Fur" />
    <part Name="Cleo_TerraFirma_CobblefurGloves" Chance="50" />
    <part Name="AddsRep" Faction="Baboons" Value="-100" />
    <tag Name="EquipSound" Value="sfx_equip_armor_fur" />
    <tag Name="Tier" Value="2" />
  </object>
    <object Name="Cleo_TerraFirma_Cobblefur Cloak" Inherits="BaseCloak">
    <part Name="Armor" AV="1" DV="0" WornOn="Back" />
    <part Name="Render" DisplayName="{{y|granitefur}} cloak" RenderString="]" Tile="Items/sw_cloak_panther.bmp" ColorString="&amp;r" DetailColor="y" /> <!-- RULED 2026-08-22: recolored base panther cloak, primary rust red, detail brown -->
    <part Name="Commerce" Value="45" /> <!-- user 2026-10-03, rough -->
    <part Name="Description" Short="Grit-caked flesh was carved from a dead baboon and sewn into a cloak." /> <!-- USER TEXT 2026-09-29, quartzfur echo -->
    <part Name="Physics" Weight="3" Organic="true" />
    <part Name="Fur" />
    <part Name="Cleo_TerraFirma_CobblefurCloak" Bonus="2" />
    <part Name="AddsRep" Faction="Baboons" Value="-100" />
    <tag Name="EquipSound" Value="sfx_equip_armor_fur" />
