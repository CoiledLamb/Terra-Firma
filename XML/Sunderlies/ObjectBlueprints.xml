  </object>

  <object Name="Cleo_TerraFirma_TopographicalMappingUnit" Load="Merge">
    <part Name="CyberneticsBaseItem" Cost="2" BehaviorDescription="Your chance of becoming lost in hills and desert canyons is reduced by 20%.&#10;This effect does not stack with the bonuses of a compass bracelet or navigation system.&#10;You can travel over mountains and the Moon Stair on the world map, at 75% reduced travel speed." />
    <part Name="Cleo_TerraFirma_OverlandPassage" />
    <tag Name="StartingCybernetic:Averter" />
    <tag Name="StartingCybernetic:Starseer" />
    <tag Name="StartingCybernetic:Surveyor" />
    <tag Name="StartingCybernetic:Lapidary" />
    <tag Name="SpecialArcologyText" Value="{{w|[Sunderlies only]}}" />
  </object>
  <object Name="Cleo_TerraFirma_JeweledSandals" Inherits="Sandals">
    <part Name="AddMod" Mods="ModJewelEncrusted" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>
</objects>
