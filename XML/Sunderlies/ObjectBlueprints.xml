    <part Name="ThrownWeapon" Penetration="3" Damage="1d6" Attributes="LongBlades" />
    <part Name="Commerce" Value="30" />
    <part Name="Description" Short="A ghostly gleam of moonpale light trails down the crescent edge of this killing instrument." />
    <part Name="Metal" />
    <tag Name="NoAIEquipAsThrownWeapon" />
    <tag Name="HideThrownWeaponPerformance" />
    <tag Name="Tier" Value="2" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>

  <object Name="Cleo_TerraFirma_AcidCanteen" Inherits="Canteen">
