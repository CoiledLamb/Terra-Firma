<?xml version="1.0" encoding="utf-8" ?>
<objects Encoding="utf-8">

  <object Name="Cleo_TerraFirma_SilverGlaive" Inherits="BaseLongBlade">
    <part Name="Render" DisplayName="{{Y|silver}} glaive" Tile="castes/silver_glaive.png" ColorString="&amp;Y" DetailColor="y" />
