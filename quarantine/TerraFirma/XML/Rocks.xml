		<part Name="Commerce" Value="1" />
		<!-- Cleo_TerraFirma_FallenRockPart (step payloads, pathfinding asymmetry, the discharge law)
		     moved to quarantine/ 2026-09-30: no live stone used any of it. -->
		<tag Name="BaseObject" Value="*noinherit" />
		<tag Name="ExcludeFromDynamicEncounters" />
		<tag Name="Tier" Value="1" />
	</object>

	<object Name="Cleo_TerraFirma_BaboonFigurineItem" Inherits="Trinket">
